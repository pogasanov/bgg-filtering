{
  "name": "bgg-player-recommendation-finder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "bgg:import-ranks": "tsx --env-file-if-exists=.env.local scripts/import-ranks.ts",
    "worker:local": "tsx --env-file-if-exists=.env.local worker/sync-entry.ts",
    "worker:build": "node scripts/build-worker.mjs",
    "worker:deploy": "pnpm worker:build && MODAL_PROFILE=bgg modal deploy worker/modal_app.py",
    "worker:run": "pnpm worker:build && MODAL_PROFILE=bgg modal run worker/modal_app.py",
    "worker:sentry-check": "pnpm worker:build && MODAL_PROFILE=bgg modal run worker/modal_app.py --sentry-check",
    "vc": "tsx --env-file-if-exists=.env.local scripts/vercel.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "11.17.0",
    "@sentry/node": "11.17.0",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fast-xml-parser": "5.10.1",
    "lucide-react": "1.25.0",
    "next": "16.2.10",
    "pg": "8.23.1",
    "radix-ui": "1.6.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadcn": "4.14.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@types/node": "26.1.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.6.0"
}
