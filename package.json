{
  "name": "bgg-player-recommendation-finder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.ts",
    "bgg:import-ranks": "tsx --env-file-if-exists=.env.local scripts/import-ranks.ts",
    "worker:local": "tsx --env-file-if-exists=.env.local worker/sync-entry.ts",
    "worker:build": "node scripts/build-worker.mjs",
    "worker:deploy": "pnpm worker:build && MODAL_PROFILE=bgfilter modal deploy worker/modal_app.py",
    "worker:run": "pnpm worker:build && MODAL_PROFILE=bgfilter modal run worker/modal_app.py",
    "worker:run-prices": "pnpm worker:build && MODAL_PROFILE=bgfilter modal run worker/modal_app.py::daily_prices",
    "worker:sentry-check": "pnpm worker:build && MODAL_PROFILE=bgfilter modal run worker/modal_app.py --sentry-check",
    "vc": "tsx --env-file-if-exists=.env.local scripts/vercel.ts",
    "prices:collect": "tsx --env-file-if-exists=.env.local scripts/prices-collect.ts",
    "prices:dry-run": "node --import ./scripts/register-alias.mjs scripts/prices-dry-run.mts",
    "db:generate": "drizzle-kit generate",
    "sentry": "SENTRY_CONFIG_DIR=${SENTRY_CONFIG_DIR:-$HOME/.config/sentry-bgg} sentry"
  },
  "dependencies": {
    "@sentry/nextjs": "11.17.0",
    "@sentry/node": "11.17.0",
    "@tailwindcss/postcss": "4.3.5",
    "@vercel/functions": "3.11.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.2",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.12.1",
    "geist": "1.9.2",
    "lucide-react": "1.80.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "posthog-js": "1.455.2",
    "radix-ui": "1.6.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.14.0",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@neon/config": "1.14.7",
    "@types/node": "26.6.10",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "sentry": "0.51.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  },
  "packageManager": "pnpm@11.6.0"
}
