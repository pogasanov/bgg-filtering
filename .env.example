# Neon pooled connection string (site, worker, local imports). `neon env pull` writes it.
DATABASE_URL=
# Neon direct connection string, used by `pnpm db:migrate` (local only). `neon env pull` writes it.
DATABASE_URL_UNPOOLED=
# BoardGameGeek XML API application token (worker; local worker runs).
BGG_TOKEN=
# Shared secret for /api/revalidate and /api/sentry-check (site and worker).
REVALIDATE_SECRET=
# Full URL of the site's revalidation endpoint, e.g. https://<project>.vercel.app/api/revalidate (worker).
REVALIDATE_URL=
# Sentry DSN exposed to the browser and used by the site's server runtime (site).
NEXT_PUBLIC_SENTRY_DSN=
# Sentry DSN for the sync worker (worker).
SENTRY_DSN=
# Sentry organization and project slugs for source map upload (site build, optional).
SENTRY_ORG=
SENTRY_PROJECT=
# Sentry auth token for source map upload (site build, optional).
SENTRY_AUTH_TOKEN=
# Optional, local only: a token from this project's Vercel account for non-interactive `pnpm vc …` runs.
# Without it, `pnpm vc login` stores the project's login in ~/.config/vercel-bgg.
VERCEL_TOKEN=
# Ownership proofs for Google Search Console, Yandex Webmaster and Bing Webmaster Tools (site build,
# optional): the content value of each one's verification meta tag. Unset ones are left out.
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
BING_SITE_VERIFICATION=
# PostHog project API key (public, phc_…) for the site's browser analytics. Unset: PostHog stays off.
NEXT_PUBLIC_POSTHOG_KEY=
