# Neon pooled connection string (site, worker, local migrations and imports).
DATABASE_URL=
# BoardGameGeek XML API application token (worker; local worker runs).
BGG_TOKEN=
# Shared secret for /api/revalidate and /api/sentry-check (site and worker).
REVALIDATE_SECRET=
# Full URL of the site's revalidation endpoint, e.g. https://<project>.vercel.app/api/revalidate (worker).
REVALIDATE_URL=
# Sentry DSN exposed to the browser and used by the site's server runtime (site).
NEXT_PUBLIC_SENTRY_DSN=
# Sentry DSN for the sync worker (worker).
SENTRY_DSN=
# Sentry organization and project slugs for source map upload (site build, optional).
SENTRY_ORG=
SENTRY_PROJECT=
# Sentry auth token for source map upload (site build, optional).
SENTRY_AUTH_TOKEN=
# Local only, from this project's Vercel account; used by `pnpm vc …`. Never commit it.
VERCEL_TOKEN=
